# ==============================================================================
# CodeSense - Environment Configuration
# Copy this file to .env and configure your values.
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development         # development | production
DEBUG=true
PORT=8501
LOG_LEVEL=INFO

# ── Security & Authentication ─────────────────────────────────────────────────
# Generate a secure 32+ character random string for production
SECRET_KEY=change-this-secret-key-in-production-min-32-chars!
SESSION_TIMEOUT_HOURS=24
MAX_LOGIN_ATTEMPTS=5
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10

# ── Email / SMTP (For 6-Digit OTP Delivery) ───────────────────────────────────
# For Gmail:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Go to "App Passwords" and create one for "CodeSense"
#   4. Paste your 16-character app password below (spaces will be stripped)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
FROM_EMAIL=your_email@gmail.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=codesense.db
DB_TIMEOUT=30
DB_POOL_SIZE=5

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=500
CACHE_DIR=cache

# ── Machine Learning ──────────────────────────────────────────────────────────
MODEL_PATH=models/codesense_model.pkl
SCALER_PATH=models/codesense_scaler.pkl
FEATURES_PATH=models/codesense_model_features.json
TARGET_R2=0.90
MIN_TRAIN_SAMPLES=5000
